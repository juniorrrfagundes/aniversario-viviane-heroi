# ============================================================
# Variáveis de ambiente — NÃO são necessárias para rodar no computador.
#
# Na Vercel:
#   - ADMIN_SENHA você cria (Settings > Environment Variables).
#   - REDIS_URL a Vercel cria sozinha quando você conecta o banco Redis na
#     aba Storage.
#
# No computador (opcional): copie este arquivo para ".env.local" e preencha.
# ============================================================

# Senha do painel /admin. No computador, se ficar vazia, a senha é "festa".
ADMIN_SENHA=

# Banco de dados Redis. No computador, deixe vazia para guardar tudo na
# memória (os dados somem quando o servidor reinicia).
REDIS_URL=

# Alternativa: Upstash for Redis (se estiver preenchido, tem prioridade).
KV_REST_API_URL=
KV_REST_API_TOKEN=
