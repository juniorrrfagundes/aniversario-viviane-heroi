# ============================================================
# Variáveis de ambiente — NÃO são necessárias para rodar no computador.
#
# Na Vercel:
#   - ADMIN_SENHA você cria (Settings > Environment Variables).
#   - KV_REST_API_URL e KV_REST_API_TOKEN a Vercel cria sozinha quando você
#     conecta o Upstash Redis na aba Storage.
#
# No computador (opcional): copie este arquivo para ".env.local" e preencha.
# ============================================================

# Senha do painel /admin. No computador, se ficar vazia, a senha é "festa".
ADMIN_SENHA=

# Banco de dados (Upstash Redis). No computador, deixe vazias para guardar
# tudo na memória (os dados somem quando o servidor reinicia).
KV_REST_API_URL=
KV_REST_API_TOKEN=
